# Nothing is required to run the tests or the guard paths. For the live demo you
# need Twilio + Anthropic; everything else is optional delivery plumbing.

# Twilio (the demo number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=           # also gates webhook signature validation (set it in prod)
TWILIO_PHONE_NUMBER=         # the number people call / that texts back, E.164: +1831...

# Call routing
OWNER_FORWARD_NUMBER=        # plumber's real cell. UNSET = pure demo mode: every call is "missed"
PUBLIC_BASE_URL=             # your ngrok https URL — needed for signature validation behind a proxy

# LLM
ANTHROPIC_API_KEY=           # model: claude-haiku-4-5 (~$0.003 per SMS turn)

# Personalization — flip these two per pitch, nothing else changes
BUSINESS_NAME=Harbor Plumbing (demo)
OWNER_NAME=Dave

# Owner notification (all optional; every handoff is always saved to messages.jsonl)
OWNER_NOTIFY_NUMBER=         # SMS the owner a summary on lead/emergency
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_WEBHOOK=                # Zapier/Make/Sheets webhook, fired per captured lead

# Value receipt
CLOSE_RATE=0.4               # owner-approved callback close rate for estimated_value

# Dashboard (/dashboard, /leads). Leads show names/addresses — set this before
# exposing the app on ngrok/prod; page is then /dashboard?key=<token>
DASH_TOKEN=
